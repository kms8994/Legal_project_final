# National Law Information Center Open API credential.
# Usually this is the OC value issued from open.law.go.kr.
LAW_API_OC=

# Optional overrides.
LAW_API_BASE_URL=https://www.law.go.kr/DRF
LAW_API_OUTPUT_TYPE=JSON
LAW_API_SAMPLE_DISPLAY=5

# Local database.
DATABASE_URL=postgresql+psycopg://caselens:caselens@localhost:5432/caselens

# Local services.
NEXT_PUBLIC_APP_URL=http://localhost:3000
SEARCH_API_URL=http://localhost:8000

# Embeddings.
# Recommended free local model. Requires sentence-transformers and first-run model download.
# The 384-dim model output is padded to the DB's vector(768) shape.
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=dragonkue/multilingual-e5-small-ko
EMBEDDING_DIMENSION=768
OPENAI_API_KEY=

# Optional generated RAG summaries.
# Create a key in Google AI Studio, then set it here to enable Gemini summaries.
# Without this key, the API uses local grounded extractive summaries.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
